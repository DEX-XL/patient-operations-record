{
  "name": "patient-ops-record",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic inpatient operations replay for the Meta AI Developer Hackathon 2026",
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs run",
    "test:watch": "node scripts/test.mjs --watch",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "guardrails": "node scripts/check-boundaries.mjs",
    "check:bundles": "node scripts/check-bundles.mjs",
    "smoke:prepare": "tsx scripts/meta-smoke.ts",
    "smoke:run": "tsx scripts/meta-smoke.ts --execute",
    "eval:dev": "tsx scripts/eval-dev.ts",
    "meta:verify": "tsx scripts/verify-meta-access.ts",
    "recording:export": "tsx scripts/export-recording.ts",
    "muse:prepare": "tsx scripts/muse-build.ts",
    "muse:run": "tsx scripts/muse-build.ts --execute",
    "muse:probe": "node scripts/probe-muse.mjs --catalog-read",
    "demo": "tsx scripts/demo.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@libsql/client": "0.18.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
