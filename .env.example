# Documentation only. Build/dev commands never load .env files.
# Set process environment explicitly when the separately approved live gate is ready.
META_LIVE_ENABLED=false
META_USE_MUSE_LOGIN=false
# Operator-owned attribution for local runs: runtimeDev | heldoutEval | publicDemo.
# Vercel always requires publicDemo. This setting cannot enable live inference.
META_RUNTIME_BUCKET=runtimeDev
MODEL_API_KEY=
DATABASE_URL=file:data/patient-ops.db
DATABASE_AUTH_TOKEN=
APP_MODE=UNAVAILABLE
# Caps are fixed in src/lib/config.ts; environment variables cannot raise them.
